local frozenMusuh={}
local function UpdateMusuhFreeze()
    if not s.musuhFreeze then
        for _,data in pairs(frozenMusuh)do
            pcall(function()data.hrp.Anchored=false end)
        end
        frozenMusuh={}
        return
    end
    local list=FindMusuh()
    for _,o in ipairs(list)do
