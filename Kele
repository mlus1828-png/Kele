-- ==== AUTO PROXIMITY PROMPT ====
local autoProxConn=nil
local function UpdateAutoProximity()
    if not s.autoProximity then
        if autoProxConn then autoProxConn:Disconnect()autoProxConn=nil end
        return
    end
    if autoProxConn then return end
    autoProxConn=R.Heartbeat:Connect(function()
        local myHRP=L.Character and L.Character:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        for _,pp in ipairs(workspace:GetDescendants())do
            if pp:IsA("ProximityPrompt")and pp.Enabled then
                local part=pp.Parent
                local pos=nil
                if part:IsA("BasePart")then pos=part.Position
                elseif part:IsA("Model")and part.PrimaryPart then pos=part.PrimaryPart.Position end
                if pos and (pos-myHRP.Position).Magnitude<=pp.MaxActivationDistance then
                    pcall(function()
                        fireproximityprompt(pp)
                    end)
                end
            end
        end
    end)
end

-- ==== AUTO COLLECT MAKANAN ====
local autoCollectRunning=false
local collectStatusTxt=Drawing.new("Text")collectStatusTxt.Size=14 collectStatusTxt.Outline=true collectStatusTxt.Color=Color3.fromRGB(0,220,255)collectStatusTxt.Visible=false
local collectCount=0

local function StopAutoCollect()
    autoCollectRunning=false
    collectStatusTxt.Visible=false
    notify("AUTO COLLECT","Selesai / dihentikan ("..collectCount.." makanan)")
end

local function GetCollectableFood()
    local list={}
    for _,obj in ipairs(workspace:GetDescendants())do
        local n=obj.Name:lower()
        for _,kw in ipairs(MAKANAN_KEYWORDS)do
            if n:find(kw)then
                local part=nil
                if obj:IsA("BasePart")then part=obj
                elseif obj:IsA("Model")then part=obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")end
                if part then table.insert(list,{obj=obj,part=part,name=obj.Name})break end
            end
        end
    end
    return list
end

local function StartAutoCollect()
    if autoCollectRunning then StopAutoCollect()return end
    local char=L.Character
    if not char then notify("AUTO COLLECT","Karakter tidak ditemukan")return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if not hrp then notify("AUTO COLLECT","HumanoidRootPart tidak ada")return end

    autoCollectRunning=true
    collectCount=0
    notify("AUTO COLLECT","Mulai ngambil semua makanan...")

    task.spawn(function()
        while autoCollectRunning do
            local char2=L.Character
            local hrp2=char2 and char2:FindFirstChild("HumanoidRootPart")
            if not hrp2 then task.wait(0.5)continue end

            local foods=GetCollectableFood()
            if #foods==0 then
                collectStatusTxt.Visible=false
                notify("AUTO COLLECT","Semua makanan habis! Total: "..collectCount)
                StopAutoCollect()
                break
            end

            -- nearest food
            local nearest=nil local nd=math.huge
            for _,k in ipairs(foods)do
                local ok,d=pcall(function()return(k.part.Position-hrp2.Position).Magnitude end)
                if ok and d<nd then nd=d nearest=k end
            end
            if not nearest then task.wait(0.3)continue end

            collectStatusTxt.Text="[AUTO COLLECT] → "..nearest.name.." | Sisa: "..#foods
            collectStatusTxt.Position=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y-50)
            collectStatusTxt.Center=true
            collectStatusTxt.Visible=true

            -- teleport ke makanan
            pcall(function()
                hrp2.CFrame=CFrame.new(nearest.part.Position+Vector3.new(0,2.5,0))
            end)

            -- coba fireproximityprompt kalau ada
            pcall(function()
                local pp=nearest.obj:FindFirstChildOfClass("ProximityPrompt")
                    or nearest.part:FindFirstChildOfClass("ProximityPrompt")
                if pp then fireproximityprompt(pp)end
            end)

            -- tunggu item hilang max 3 detik
            local waited=0
            while waited<3 and autoCollectRunning do
                local gone=false
                pcall(function()
                    local p=nearest.obj.Parent
                    if p==nil then gone=true end
                end)
                if gone or not nearest.obj.Parent then
                    collectCount=collectCount+1
                    notify("COLLECTED","✓ "..nearest.name.." ("..collectCount..")")
                    break
                end
                task.wait(0.1)
                waited=waited+0.1
            end

            task.wait(0.3)
        end
        collectStatusTxt.Visible=false
    end)
end

