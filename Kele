local MUSUH_KEYWORDS={"enemy","musuh","predator","spider","laba","centipede","beetle","kumbang","wasp","tawon","boss","threat","danger"}
local function FindMusuh()
    local results={}
    for _,obj in ipairs(workspace:GetDescendants())do
        if obj:IsA("Model")then
            local n=obj.Name:lower()
            for _,kw in ipairs(MUSUH_KEYWORDS)do
                if n:find(kw)then
                    local hrp=obj:FindFirstChild("HumanoidRootPart")or obj:FindFirstChild("HRP")or obj.PrimaryPart
                    local hum=obj:FindFirstChildOfClass("Humanoid")
                    if hrp then table.insert(results,{model=obj,hrp=hrp,hum=hum})break end
                end
            end
        end
    end
    return results
end

