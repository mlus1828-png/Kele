-- ==== DRAWING POOL ====
local musuhESPDrawings={}
local makananESPDrawings={}
local sarangESPDrawings={}

local function GetOrCreate(pool,key,dtype)
    if not pool[key]then pool[key]=Drawing.new(dtype)end
    return pool[key]
end
local function HideAll(pool)
    for _,d in pairs(pool)do
        if type(d)=="table"then for _,v in pairs(d)do pcall(function()v.Visible=false end)end
        else pcall(function()d.Visible=false end)end
    end
end

-- ==== MUSUH ESP ====
local function UpdateMusuhESP()
    HideAll(musuhESPDrawings)
    if not s.musuhESP then return end
    local list=FindMusuh()
    for i,o in ipairs(list)do
        local pos=o.hrp.Position
        local sp,on=W2S(pos)
        if not on then continue end
        local top=W2S(pos+Vector3.new(0,3,0))
        local bot=W2S(pos-Vector3.new(0,3,0))
        local hgt=math.abs((top.Y or sp.Y-30)-(bot.Y or sp.Y+30))
        local wdt=hgt*0.5
        local k="musuh_"..i
        local box=GetOrCreate(musuhESPDrawings,k.."_box","Square")
        box.Size=Vector2.new(wdt,hgt)
        box.Position=Vector2.new(sp.X-wdt/2,sp.Y-hgt/2)
        box.Color=Color3.fromRGB(255,60,0)
        box.Thickness=2 box.Filled=false box.Visible=true
        local lbl=GetOrCreate(musuhESPDrawings,k.."_lbl","Text")
        local dist=math.floor((pos-Camera.CFrame.Position).Magnitude)
        local hp=""
        if o.hum then hp=" | HP:"..math.floor(o.hum.Health)end
        lbl.Text="["..o.model.Name.."] "..dist.."m"..hp
        lbl.Size=15 lbl.Center=true lbl.Outline=true
        lbl.Color=Color3.fromRGB(255,100,50)
        lbl.Position=Vector2.new(sp.X,sp.Y-hgt/2-20)
        lbl.Visible=true
    end
end

