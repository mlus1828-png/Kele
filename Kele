-- ==== MUSUH DIRECTION ARROW ====
local arrowLine1=Drawing.new("Line")arrowLine1.Thickness=3 arrowLine1.Color=Color3.fromRGB(255,80,0)arrowLine1.Visible=false
local arrowLine2=Drawing.new("Line")arrowLine2.Thickness=3 arrowLine2.Color=Color3.fromRGB(255,80,0)arrowLine2.Visible=false
local arrowLine3=Drawing.new("Line")arrowLine3.Thickness=3 arrowLine3.Color=Color3.fromRGB(255,80,0)arrowLine3.Visible=false
local function UpdateMusuhArrow()
    arrowLine1.Visible=false arrowLine2.Visible=false arrowLine3.Visible=false
    if not s.musuhArrow then return end
    local myHRP=L.Character and L.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local list=FindMusuh()
    local nearest,nd=nil,math.huge
    for _,o in ipairs(list)do
        local d=(o.hrp.Position-myHRP.Position).Magnitude
        if d<nd then nd=d nearest=o end
    end
    if not nearest then return end
    local sp,on=W2S(nearest.hrp.Position)
    local cx=Camera.ViewportSize.X/2
    local cy=Camera.ViewportSize.Y/2
    local dx=sp.X-cx local dy=sp.Y-cy
    local len=math.sqrt(dx*dx+dy*dy)
    if len<1 then return end
    local nx=dx/len local ny=dy/len
    local edge=120
    local ex=cx+nx*edge local ey=cy+ny*edge
    if on and len<edge then ex=sp.X ey=sp.Y end
    arrowLine1.From=Vector2.new(cx+nx*(edge-30),cy+ny*(edge-30))
    arrowLine1.To=Vector2.new(ex,ey)
    arrowLine1.Visible=true
    local ang1=math.atan2(ny,nx)+2.5
    arrowLine2.From=Vector2.new(ex,ey)
    arrowLine2.To=Vector2.new(ex+math.cos(ang1)*14,ey+math.sin(ang1)*14)
    arrowLine2.Visible=true
    local ang2=math.atan2(ny,nx)-2.5
    arrowLine3.From=Vector2.new(ex,ey)
    arrowLine3.To=Vector2.new(ex+math.cos(ang2)*14,ey+math.sin(ang2)*14)
    arrowLine3.Visible=true
end

