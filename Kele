local function TG(b,o,t)
    b.Text=t..(o and "\n[ON]" or "\n[OFF]")
    local d=buttons[b]
    if d then
        d.on=o d.baseText=t
        T:Create(b,TweenInfo.new(0.2),{BackgroundColor3=o and Color3.fromRGB(16,60,44)or Color3.fromRGB(16,22,34)}):Play()
        T:Create(d.s,TweenInfo.new(0.2),{Color=o and Color3.fromRGB(0,255,150)or Color3.fromRGB(0,120,255),Transparency=o and 0 or 0.6}):Play()
        T:Create(d.dot,TweenInfo.new(0.2),{BackgroundColor3=o and Color3.fromRGB(0,255,150)or Color3.fromRGB(0,150,255)}):Play()
    end
end

local function layout()
    local q=SBi.Text:lower()
    local vis={}
    for b,d in pairs(buttons)do
        local matchQ=(q=="" or string.find(d.baseText:lower(),q,1,true))
        local matchC=(currentCat=="ALL" or d.cat==currentCat)
        b.Visible=matchQ and matchC
        if b.Visible then table.insert(vis,b)end
    end
    local x,y=0,0
    for _,b in ipairs(vis)do
        b.Position=UDim2.new(0,x,0,y)
        x=x+148
        if x>=440 then x=0 y=y+60 end
    end
    Sc.CanvasSize=UDim2.new(0,0,0,y+70)
end

local function makeCat(name)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(0,70,1,0)
    b.BackgroundColor3=Color3.fromRGB(16,22,34)
    b.TextColor3=Color3.fromRGB(140,180,220)
    b.Font=Enum.Font.GothamBold b.TextSize=10 b.Text=name b.AutoButtonColor=false
